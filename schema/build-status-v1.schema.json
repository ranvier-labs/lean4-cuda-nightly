{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ranvier.systems/lean-cuda/schema/build-status-v1.schema.json",
  "title": "Lean CUDA nightly build status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "channel",
    "state",
    "releaseId",
    "startedAt",
    "updatedAt",
    "message"
  ],
  "properties": {
    "schema": { "const": "lean.cuda.build-status/v1" },
    "channel": { "const": "nightly" },
    "state": { "enum": ["running", "accepted", "failed"] },
    "releaseId": {
      "type": "string",
      "pattern": "^nightly-[0-9]{4}-[0-9]{2}-[0-9]{2}(-rev[1-9][0-9]*)?$"
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "message": { "type": "string", "minLength": 1 }
  }
}
