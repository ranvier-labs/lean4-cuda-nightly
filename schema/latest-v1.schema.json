{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ranvier.systems/lean-cuda/schema/latest-v1.schema.json",
  "title": "Lean CUDA latest nightly pointer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "channel", "release"],
  "properties": {
    "schema": { "const": "lean.cuda.latest/v1" },
    "channel": { "const": "nightly" },
    "release": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "index-v1.schema.json#/$defs/summary" }
      ]
    }
  }
}
